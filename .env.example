# Render/Docker production example. Replace placeholders; never commit a real .env.
# ASP.NET does not load this file automatically. Use Render Environment or docker --env-file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=10000
# Mount the Supabase CA at /etc/secrets/supabase-ca.crt (Render Secret Files, or Docker read-only mount).
ConnectionStrings__DefaultConnection=Host=YOUR_SESSION_POOLER;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=VerifyFull;Root Certificate=/etc/secrets/supabase-ca.crt;GSS Encryption Mode=Disable;Maximum Pool Size=10
Database__ApplyMigrations=true
Storage__Provider=Supabase
Storage__Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Storage__Supabase__Bucket=wida-originals
Storage__Supabase__ServiceKey=YOUR_SUPABASE_SERVER_SECRET_KEY
Authentication__PublicOrigin=https://YOUR_FRONTEND_DOMAIN
Authentication__PublicBeta=true
Authentication__AdminEmail=YOUR_GOOGLE_EMAIL
Authentication__Google__ClientId=YOUR_GOOGLE_CLIENT_ID
Authentication__Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET
Authentication__ProxySecret=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Authentication__DataProtectionProvider=Database
Authentication__DataProtectionCertificateBase64=YOUR_BASE64_PFX
Authentication__DataProtectionCertificatePassword=YOUR_PFX_PASSWORD
ProcessingQueue__Enabled=true
RabbitMQ__Uri=amqps://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_BROKER/YOUR_VHOST
RabbitMQ__QueueType=classic
RabbitMQ__QueueName=wida.invoice-analysis.free.v1
AzureDocumentIntelligence__Tier=F0
AzureDocumentIntelligence__Endpoint=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AzureDocumentIntelligence__Key=YOUR_AZURE_KEY
